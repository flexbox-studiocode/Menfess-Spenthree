GROQ_API_KEY=
MODERATION_MODEL=openai/gpt-oss-120b
MODERATION_POLICY_REVISION=school-v1
# Confirm organization limits in Groq console before using real data.
MODERATION_REQUESTS_PER_MINUTE=30
MODERATION_REQUESTS_PER_DAY=1000
MODERATION_TOKENS_PER_MINUTE=8000
MODERATION_TOKENS_PER_DAY=200000
# Server-only scheduler credential, independently generated (at least 32 characters).
MODERATION_WORKER_SECRET=

# Server-only credentials. Never put these in VITE_* or tracked local files.
TRACKING_HASH_SECRET=
PAYLOAD_HASH_SECRET=
RECEIPT_ENCRYPTION_SECRET=
WORKER_CRON_SECRET=
RENDERER_URL=
RENDERER_SECRET=
# Explicitly select instagram_login or facebook_login to match the token flow.
INSTAGRAM_AUTH_MODE=instagram_login
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Select a currently supported version in Meta Developer Dashboard.
INSTAGRAM_API_VERSION=
INSTAGRAM_PUBLISH_ENABLED=false
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Edge runtime.
# Scheduler Vault configuration is separate: SUPABASE_PROJECT_URL and worker secrets.
